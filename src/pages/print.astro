---
/**
 * Print layout rendered to /resume.pdf by scripts/build-pdf.ts. Light, editorial, A4, at most 2 pages.
 * Hack for structure (matching the site), Source Serif 4 for reading text.
 */
import '@fontsource-variable/source-serif-4/index.css';
import QRCode from 'qrcode';
import { resume, featured, masked, github, fmtYm, n } from '../lib/data';

const { basics, work } = resume;
const gh = basics.profiles.find((p) => p.network === 'GitHub')!;
const li = basics.profiles.find((p) => p.network === 'LinkedIn')!;
const site = basics.url.replace(/^https?:\/\//, '');
const qr = await QRCode.toString(basics.url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1e1e1e', light: '#ffffff00' } });

// Older roles keep fewer bullets so the document stays within two pages.
const bulletLimit = (i: number) => (i === 0 ? 6 : i < 4 ? 4 : 2);
const topProjects = [...featured.slice(0, 3), ...masked.slice(0, 2)];
const [user, domain] = basics.email.split('@');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{basics.name} · Resume</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="page">
      <header class="top">
        <div>
          <h1>{basics.name}</h1>
          <p class="label">{basics.label}</p>
          <p class="contact">
            <a class="js-email" data-u={user.split('').reverse().join('')} data-d={domain} href="#">{user} [at] {domain}</a>
            <span>{basics.location.city}, {basics.location.region}</span>
            <a href={gh.url}>github.com/{gh.username}</a>
            <a href={li.url}>linkedin.com/in/{li.username}</a>
          </p>
        </div>
        <a class="qr" href={basics.url} aria-label={`Live resume at ${site}`}>
          <Fragment set:html={qr} />
          <span>{site}</span>
        </a>
      </header>

      <p class="summary">{basics.summary}</p>

      <section>
        <h2>Experience</h2>
        {work.map((w, i) => (
          <article class="job">
            <div class="job-head">
              <h3>{w.position} <span class="org">· {w.name}</span></h3>
              <p class="dates">{fmtYm(w.startDate)} – {w.endDate ? fmtYm(w.endDate) : 'Present'}</p>
            </div>
            <p class="loc">{w.location}</p>
            <ul>
              {w.highlights.slice(0, bulletLimit(i)).map((h) => <li>{h}</li>)}
            </ul>
          </article>
        ))}
      </section>

      <section>
        <h2>Skills</h2>
        <dl class="skills">
          {resume.skills.map((s) => (
            <div><dt>{s.name}</dt><dd>{s.keywords.join(', ')}</dd></div>
          ))}
        </dl>
      </section>

      <section>
        <h2>Projects on GitHub</h2>
        <p class="muted small">{n(github.totals.myCommits)} commits of mine across {github.totals.repos} repositories, {n(github.totals.commits90d)} in the last 90 days.</p>
        <ul class="projects">
          {topProjects.map((p) => (
            <li>
              <strong>{p.title}</strong>
              {p.kind === 'masked' && <span class="muted"> (private)</span>}
              <span class="muted"> · {p.stack.slice(0, 2).join(', ')}{p.stats && ` · ${n(p.stats.myCommits)} commits`}</span>
              <br /><span class="blurb">{p.blurb}</span>
            </li>
          ))}
        </ul>
      </section>

      <div class="split">
        <section>
          <h2>Certificates</h2>
          <ul class="plain">
            {resume.certificates.map((c) => <li>{c.name} <span class="muted">· {c.issuer}, {fmtYm(c.date)}</span></li>)}
          </ul>
        </section>
        <section>
          <h2>Education</h2>
          {resume.education.map((e) => (
            <p>{e.studyType} in {e.area}<br /><span class="muted">{e.institution}, {e.startDate}–{e.endDate}</span></p>
          ))}
          <h2 class="gap">Languages</h2>
          <p>{resume.languages.map((l) => `${l.language} (${l.fluency})`).join(', ')}</p>
        </section>
      </div>
    </main>
    <script>
      document.querySelectorAll<HTMLAnchorElement>('a.js-email').forEach((a) => {
        const addr = `${(a.dataset.u || '').split('').reverse().join('')}@${a.dataset.d}`;
        a.href = `mailto:${addr}`;
        a.textContent = addr;
      });
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: Hack; src: url('/fonts/hack-regular.woff2') format('woff2'); font-weight: 400; }
  @font-face { font-family: Hack; src: url('/fonts/hack-bold.woff2') format('woff2'); font-weight: 700; }

  @page { size: A4; margin: 13mm 14mm 12mm; }

  :root { --ink: #1e1e1e; --muted: #5f6368; --rule: #d4d4d4; --accent: #0f7b3c; --link: #0451a5; }
  * { box-sizing: border-box; }
  html { background: #e4e6ea; }
  body {
    margin: 0;
    color: var(--ink);
    font-family: 'Source Serif 4 Variable', 'Source Serif 4', Georgia, serif;
    font-size: 9.6pt;
    line-height: 1.38;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .page { background: #fff; max-width: 210mm; margin: 0 auto; padding: 13mm 14mm; }
  @media screen and (max-width: 700px) { .page { padding: 20px 16px; } }
  @media print {
    html { background: #fff; }
    .page { padding: 0; max-width: none; }
  }

  h1, h2, h3, .label, .dates, .contact, .qr span, .tick { font-family: Hack, ui-monospace, Menlo, monospace; }
  p, ul, h1, h2, h3, dl { margin: 0; }
  a { color: var(--link); text-decoration: none; }
  .muted { color: var(--muted); }
  .small { font-size: 8.8pt; margin-bottom: 1.5mm; }

  .top { display: flex; justify-content: space-between; gap: 6mm; align-items: flex-start; }
  h1 { font-size: 21pt; line-height: 1.1; letter-spacing: -0.02em; }
  .label { color: var(--accent); font-weight: 700; font-size: 10pt; margin-top: 1mm; }
  .contact { display: flex; flex-wrap: wrap; gap: 0.5mm 4mm; font-size: 8pt; margin-top: 2mm; color: var(--muted); }
  .qr { display: flex; flex-direction: column; align-items: center; gap: 1mm; flex: none; color: var(--muted); }
  .qr svg { width: 19mm; height: 19mm; }
  .qr span { font-size: 6.8pt; }
  .summary { margin: 4mm 0 1mm; max-width: 170mm; }

  section { margin-top: 3.6mm; }
  h2 {
    font-size: 8.6pt;
    font-weight: 700;
    color: var(--accent);
    border-bottom: 0.6pt solid var(--rule);
    padding-bottom: 0.8mm;
    margin-bottom: 1.8mm;
    break-after: avoid;
  }
  h2::before { content: '## '; color: #9aa0a6; }
  h2.gap { margin-top: 3mm; }

  .job { margin-bottom: 2.6mm; break-inside: avoid; }
  .job-head { display: flex; justify-content: space-between; gap: 4mm; align-items: baseline; }
  h3 { font-size: 9.4pt; font-weight: 700; }
  h3 .org { font-weight: 400; }
  .dates { font-size: 8pt; color: var(--muted); white-space: nowrap; }
  .loc { font-size: 8.6pt; color: var(--muted); font-style: italic; }
  .job ul, .projects { padding-left: 4mm; margin-top: 0.6mm; }
  .job li { margin-bottom: 0.3mm; }

  .results { break-inside: avoid; }
  .cols { list-style: none; padding: 0; columns: 2; column-gap: 7mm; }
  .cols li { break-inside: avoid; margin-bottom: 0.6mm; }
  .tick { color: var(--accent); font-weight: 700; }

  .skills { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8mm 7mm; break-inside: avoid; }
  .skills div { display: grid; grid-template-columns: 30mm 1fr; gap: 2mm; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; }

  .projects { list-style: square; break-inside: avoid; }
  .projects li { margin-bottom: 1mm; }
  .blurb { font-size: 9pt; }

  .split { display: grid; grid-template-columns: 1.35fr 1fr; gap: 7mm; break-inside: avoid; }
  .plain { list-style: none; padding: 0; }
  .plain li { margin-bottom: 0.4mm; }
</style>
